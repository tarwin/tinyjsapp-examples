{
  "name": "nib",
  "title": "Nib",
  "size": "560x468",
  "id": "art.tarwin.nib",
  "version": "0.5.1",
  "minTinyjsVersion": "0.50.1",
  "backend": "src/backend/main.js",
  "update": {
    "url": "https://raw.githubusercontent.com/tarwin/tinyjsapp-examples/main/_builds/nib/manifest.json",
    "auto": "daily"
  },
  "fileExtensions": [
    "md",
    "markdown",
    "mdown",
    "mkdn",
    "mkd",
    "mdwn",
    "mdtxt",
    "mdtext"
  ],
  "openFolders": true,
  "about": "menu",
  "permissions": {
    "microphone": "Nib uses the microphone only while you are dictating into a document.",
    "speechRecognition": "Dictation turns what you say into text at your caret."
  },
  "windows": {
    "chrome": {
      "menu": false
    }
  },
  "linux": {
    "chrome": {
      "menu": false
    }
  }
}
