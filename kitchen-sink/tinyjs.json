{
  "name": "kitchen-sink",
  "title": "Tiny Deck",
  "size": "1100x720",
  "id": "art.tarwin.kitchen-sink",
  "version": "0.17.0",
  "minTinyjsVersion": "0.32.0",
  "urlScheme": "tinydeck",
  "readAccess": true,
  "fileExtensions": [
    "txt",
    "md",
    "log"
  ],
  "update": {
    "url": "https://raw.githubusercontent.com/tarwin/tinyjsapp-examples/main/_builds/kitchen-sink/manifest.json",
    "auto": "daily"
  },
  "permissions": {
    "microphone": "Tiny Deck listens so you can talk to the on-device model.",
    "speechRecognition": "Tiny Deck transcribes what you say so the on-device model can answer it."
  }
}
