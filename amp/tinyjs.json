{
  "name": "amp",
  "title": "amp",
  "size": "320x172",
  "id": "art.tarwin.amp",
  "version": "0.10.2",
  "minTinyjsVersion": "0.32.0",
  "update": {
    "url": "https://raw.githubusercontent.com/tarwin/tinyjsapp-examples/main/_builds/amp/manifest.json",
    "auto": "daily"
  },
  "chrome": {
    "frame": false,
    "windowControls": false,
    "squareCorners": true,
    "acceptsFirstMouse": true
  },
  "readAccess": "/",
  "audioTap": "app",
  "windowPlacement": true,
  "fileExtensions": [
    "mp3", "m4a", "aac", "flac", "wav",
    "aif", "aiff", "caf", "oga", "ogg", "opus",
    "mid", "midi",
    "mod", "s3m", "xm", "it", "mptm"
  ]
}
